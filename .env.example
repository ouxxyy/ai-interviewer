# AI 面试官 本地服务配置示例（复制为 .env 后填写；.env 已被 .gitignore 排除，绝不提交）
# 凭证只放本机环境变量或 .env，不进对话、不进代码、不进日志与报告。

# 阿里百炼（DashScope）API Key——默认文本模型与 Qwen-Omni-Realtime 共用
# 也可启动网页后进入「模型配置」页填写；页面只把 Key 提交给 127.0.0.1 本地服务，服务端写入项目根 .env。
DASHSCOPE_API_KEY=

# 可选：覆盖默认端点（一般不需要）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 国内端点代理例外：本机若开 Clash 全局代理，需确保国内 API 不走代理（T1-R 自测项）
# 服务启动脚本会读取该值；留空时服务按系统环境执行
NO_PROXY=dashscope.aliyuncs.com,localhost,127.0.0.1

# 高级设置：OpenAI 兼容自定义端点（D10：自定义配置下评审一致性未经验证）
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=

# 可选：Vite 产品构建产物目录（默认 dist/web-client；相对路径按仓库根解析）
# AI_INTERVIEWER_WEB_DIST=dist/web-client

# 公网部署显式开启；默认留空为本地单用户模式
# AI_INTERVIEWER_PUBLIC=on
# AI_INTERVIEWER_PUBLIC_ORIGIN=https://interview.redboook.cn
# AI_INTERVIEWER_DATA_DIR=/www/ai-interviewer/data
