{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ai-interviewer:session-report@0.2.0",
  "title": "SessionReport",
  "description": "全场报告。零完成也生成报告并明确说明（D6），不生成伪报告。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "sessionStatus", "completedQuestions", "totalQuestions", "perQuestion", "priorityPractice", "versions"],
  "properties": {
    "contractVersion": { "enum": ["0.2.0"] },
    "sessionStatus": { "enum": ["completed", "ended_early"] },
    "completedQuestions": { "type": "integer", "minimum": 0, "maximum": 3 },
    "totalQuestions": { "const": 3 },
    "perQuestion": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "status", "feedback", "rewriteDelta"],
        "properties": {
          "questionId": { "type": "string", "pattern": "^q[1-9][0-9]*$" },
          "status": { "enum": ["reviewed", "skipped", "not_reached"] },
          "feedback": { "anyOf": [{ "type": "null" }, { "$ref": "urn:ai-interviewer:feedback@0.2.0" }] },
          "rewriteDelta": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["added", "corrected", "stillMissing"],
                "properties": {
                  "added": { "type": "array", "items": { "type": "string", "minLength": 2 } },
                  "corrected": { "type": "array", "items": { "type": "string", "minLength": 2 } },
                  "stillMissing": { "type": "array", "items": { "type": "string", "minLength": 2 } }
                }
              }
            ]
          }
        }
      }
    },
    "priorityPractice": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleVersion", "realtimeModel", "textModel"],
      "properties": {
        "ruleVersion": { "type": "string", "minLength": 1 },
        "realtimeModel": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "textModel": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    }
  }
}
