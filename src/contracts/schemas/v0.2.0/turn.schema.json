{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ai-interviewer:turn@0.2.0",
  "title": "Turn",
  "description": "一个说话轮次。评分只使用用户确认后的回答文本（D1/D11 口径）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "id", "questionId", "speaker", "turnType", "seq", "startedAt", "endedAt", "rawTranscript", "revisedText", "audioFile"],
  "properties": {
    "contractVersion": { "enum": ["0.2.0"] },
    "id": { "type": "string", "pattern": "^t[1-9][0-9]*$" },
    "questionId": { "type": "string", "pattern": "^q[1-9][0-9]*$" },
    "speaker": { "enum": ["user", "interviewer"] },
    "turnType": { "enum": ["question", "answer", "followup", "rewrite"] },
    "seq": { "type": "integer", "minimum": 1 },
    "startedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "endedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "rawTranscript": { "type": "string", "minLength": 1 },
    "revisedText": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "audioFile": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
  }
}
