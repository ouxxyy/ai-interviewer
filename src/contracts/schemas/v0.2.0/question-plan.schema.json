{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ai-interviewer:question-plan@0.2.0",
  "title": "QuestionPlan",
  "description": "一场训练的 3 道主问题计划，问题随 JD／经历变化，不允许换措辞重复。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "questions", "askedTopics"],
  "properties": {
    "contractVersion": { "enum": ["0.2.0"] },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "sourceExcerpt", "intent", "topics"],
        "properties": {
          "id": { "type": "string", "pattern": "^q[1-9][0-9]*$" },
          "text": { "type": "string", "minLength": 8 },
          "sourceExcerpt": { "type": "string", "minLength": 4 },
          "intent": { "type": "string", "minLength": 4 },
          "topics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
        }
      }
    },
    "askedTopics": { "type": "array", "items": { "type": "string", "minLength": 2 } }
  }
}
