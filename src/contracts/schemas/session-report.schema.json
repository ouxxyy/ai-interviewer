{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ai-interviewer:session-report@0.3.0",
  "title": "SessionReport",
  "description": "全场报告。零完成也生成报告并明确说明（D6），不生成伪报告。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "sessionStatus",
    "completedQuestions",
    "totalQuestions",
    "perQuestion",
    "priorityPractice",
    "versions"
  ],
  "properties": {
    "contractVersion": {
      "enum": [
        "0.3.0"
      ]
    },
    "sessionStatus": {
      "enum": [
        "completed",
        "ended_early"
      ]
    },
    "completedQuestions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "totalQuestions": {
      "const": 4
    },
    "perQuestion": {
      "type": "array",
      "maxItems": 4,
      "items": [
        {
          "type": "object",
          "$ref": "#/definitions/reportQuestion",
          "properties": {
            "questionId": {
              "const": "q1"
            },
            "kind": {
              "const": "introduction"
            }
          }
        },
        {
          "type": "object",
          "$ref": "#/definitions/reportQuestion",
          "properties": {
            "questionId": {
              "const": "q2"
            },
            "kind": {
              "const": "experience"
            }
          }
        },
        {
          "type": "object",
          "$ref": "#/definitions/reportQuestion",
          "properties": {
            "questionId": {
              "const": "q3"
            },
            "kind": {
              "const": "experience"
            }
          }
        },
        {
          "type": "object",
          "$ref": "#/definitions/reportQuestion",
          "properties": {
            "questionId": {
              "const": "q4"
            },
            "kind": {
              "const": "experience"
            }
          }
        }
      ],
      "minItems": 4,
      "additionalItems": false
    },
    "priorityPractice": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleVersion",
        "realtimeModel",
        "textModel"
      ],
      "properties": {
        "ruleVersion": {
          "type": "string",
          "minLength": 1
        },
        "realtimeModel": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "textModel": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "reportQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "kind",
        "status",
        "feedback",
        "rewriteDelta"
      ],
      "properties": {
        "questionId": {
          "type": "string",
          "pattern": "^q[1-4]$"
        },
        "status": {
          "enum": [
            "reviewed",
            "skipped",
            "not_reached"
          ]
        },
        "feedback": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:ai-interviewer:feedback@0.3.0"
            }
          ]
        },
        "rewriteDelta": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "added",
                "corrected",
                "stillMissing"
              ],
              "properties": {
                "added": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2
                  }
                },
                "corrected": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2
                  }
                },
                "stillMissing": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2
                  }
                }
              }
            }
          ]
        },
        "kind": {
          "enum": [
            "introduction",
            "experience"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "feedback": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "feedback": {
                "type": "null"
              },
              "rewriteDelta": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
