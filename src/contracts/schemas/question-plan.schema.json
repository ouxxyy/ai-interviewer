{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:ai-interviewer:question-plan@0.3.0",
  "title": "QuestionPlan",
  "description": "一场训练一次生成四项：q1 自我介绍，q2–q4 经历题，不根据介绍改写后续题目。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "questions",
    "askedTopics"
  ],
  "properties": {
    "contractVersion": {
      "enum": [
        "0.3.0"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": [
        {
          "type": "object",
          "$ref": "#/definitions/plannedQuestion",
          "properties": {
            "id": {
              "const": "q1"
            },
            "kind": {
              "const": "introduction"
            }
          }
        },
        {
          "type": "object",
          "$ref": "#/definitions/plannedQuestion",
          "properties": {
            "id": {
              "const": "q2"
            },
            "kind": {
              "const": "experience"
            }
          }
        },
        {
          "type": "object",
          "$ref": "#/definitions/plannedQuestion",
          "properties": {
            "id": {
              "const": "q3"
            },
            "kind": {
              "const": "experience"
            }
          }
        },
        {
          "type": "object",
          "$ref": "#/definitions/plannedQuestion",
          "properties": {
            "id": {
              "const": "q4"
            },
            "kind": {
              "const": "experience"
            }
          }
        }
      ],
      "additionalItems": false
    },
    "askedTopics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    }
  },
  "definitions": {
    "plannedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "sourceExcerpt",
        "intent",
        "topics"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[1-4]$"
        },
        "text": {
          "type": "string",
          "minLength": 8
        },
        "sourceExcerpt": {
          "type": "string",
          "minLength": 4
        },
        "intent": {
          "type": "string",
          "minLength": 4
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "kind": {
          "enum": [
            "introduction",
            "experience"
          ]
        }
      }
    }
  }
}
