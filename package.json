{
  "name": "ai-interviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 JD 与经历的中文 AI 面试训练工具（三入口 MVP）——T1-S 静态验收包",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "validate": "node dist/src/contracts/validate-cli.js",
    "prototype": "node dist/src/prototype/server.js",
    "prototype:run": "npm run build && node dist/src/prototype/run-evidence.js",
    "check:env": "bash scripts/env-check.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
